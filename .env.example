# ---------- 预览模式 ----------
# true  = 使用 src/mock 的演示数据（不需要后端）
# false = 连接真实后端（正式登录 + 真实接口）
VITE_PREVIEW=true

# ---------- 后端地址 ----------
# 开发环境 Vite 代理目标（网关前缀 /go：/api/** 会转发到 <target>/api/**）
VITE_PROXY_TARGET=https://dssczt.shininghouse.vip/go

# 后端按 Origin 校验来源时，代理转发使用的 Origin（须为后端 CORS_ALLOWED_ORIGIN 允许的值）
VITE_PROXY_ORIGIN=https://dssczt.shininghouse.vip

# 可选：直连后端时设置完整 API 根地址（默认使用相对路径 /api 走代理）
# VITE_API_BASE=https://dssczt.shininghouse.vip/go/api
